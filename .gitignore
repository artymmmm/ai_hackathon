# окружение
.venv/
__pycache__/
*.pyc

# секреты
.env
*.key
secrets*

# датасеты (качаются заново, в репозиторий не кладём)
case 1/
case 2/
case 3/
*.parquet

# кеши и мусор ОС
.DS_Store
# сырой дамп предыдущей сессии, содержимое разнесено по STATE.md и journal.md
last_session.txt
.idea/
.cache/

# артефакты прогонов
# (игнорируем содержимое, а не саму директорию — иначе исключения ниже не сработают)
out/*
# ...кроме эталонного набора и сырых вердиктов бенчмарка: без них
# сравнение моделей невоспроизводимо
!out/bench/

# CA-бандл для GigaChat: собирается локально из certifi + сертификатов НУЦ Минцифры
certs/

# база знаний: крупный XML качается заново одной командой, в репозиторий не кладём
kb/*.xml
kb/*.zip

# веса и датасеты HF, скачанные для замера дообученной модели (589 МБ)
cases/codereview/out/hf_model_*/
cases/codereview/out/hf_dataset_*/

# временные файлы Word (замок открытого документа)
~$*
